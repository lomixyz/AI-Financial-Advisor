<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ================================================================ -->
    <!-- AI Model Catalog — Tree View (editable, grouped by provider)     -->
    <!-- ================================================================ -->
    <record id="view_ai_financial_model_config_tree" model="ir.ui.view">
        <field name="name">ai.financial.model.config.tree</field>
        <field name="model">ai.financial.model.config</field>
        <field name="arch" type="xml">
            <tree string="AI Models" editable="bottom" multi_edit="1" default_group_by="provider">
                <field name="sequence" widget="handle"/>
                <field name="provider"/>
                <field name="name" placeholder="e.g. claude-sonnet-4-6"/>
                <field name="display_name" placeholder="e.g. Claude Sonnet 4.6 (Recommended)"/>
                <field name="state" widget="badge"
                       decoration-success="state == 'active'"
                       decoration-warning="state == 'legacy'"
                       decoration-danger="state == 'deprecated'"/>
                <field name="is_default"/>
                <field name="notes" optional="hide"/>
                <field name="active" widget="boolean_toggle"/>
            </tree>
        </field>
    </record>

    <!-- ================================================================ -->
    <!-- AI Model Catalog — Form View                                     -->
    <!-- ================================================================ -->
    <record id="view_ai_financial_model_config_form" model="ir.ui.view">
        <field name="name">ai.financial.model.config.form</field>
        <field name="model">ai.financial.model.config</field>
        <field name="arch" type="xml">
            <form string="AI Model">
                <sheet>
                    <widget name="web_ribbon" title="Archived" bg_color="text-bg-danger"
                            invisible="active"/>
                    <div class="oe_title">
                        <h1>
                            <field name="display_name" placeholder="e.g. Claude Sonnet 4.6 (Recommended)"/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="provider"/>
                            <field name="name" placeholder="e.g. claude-sonnet-4-6"/>
                            <field name="state"/>
                        </group>
                        <group>
                            <field name="sequence"/>
                            <field name="is_default"/>
                            <field name="active"/>
                        </group>
                    </group>
                    <group string="Notes">
                        <field name="notes" nolabel="1" placeholder="Optional: retirement date, pricing tier, context window…"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- ================================================================ -->
    <!-- AI Model Catalog — Search View                                   -->
    <!-- ================================================================ -->
    <record id="view_ai_financial_model_config_search" model="ir.ui.view">
        <field name="name">ai.financial.model.config.search</field>
        <field name="model">ai.financial.model.config</field>
        <field name="arch" type="xml">
            <search string="AI Models">
                <field name="display_name" string="Model"/>
                <field name="name" string="Model ID"/>
                <field name="provider"/>
                <separator/>
                <filter name="active_models" string="Active" domain="[('active', '=', True)]"/>
                <filter name="archived_models" string="Archived" domain="[('active', '=', False)]"/>
                <separator/>
                <filter name="claude" string="Claude" domain="[('provider', '=', 'claude')]"/>
                <filter name="chatgpt" string="ChatGPT" domain="[('provider', '=', 'chatgpt')]"/>
                <filter name="deepseek" string="DeepSeek" domain="[('provider', '=', 'deepseek')]"/>
                <filter name="grok" string="Grok" domain="[('provider', '=', 'grok')]"/>
                <filter name="gemini" string="Gemini" domain="[('provider', '=', 'gemini')]"/>
                <separator/>
                <filter name="defaults_only" string="Default Models" domain="[('is_default', '=', True)]"/>
                <group expand="1" string="Group By">
                    <filter name="group_by_provider" string="AI Provider" context="{'group_by': 'provider'}"/>
                    <filter name="group_by_state" string="Status" context="{'group_by': 'state'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- ================================================================ -->
    <!-- Action                                                           -->
    <!-- ================================================================ -->
    <record id="action_ai_financial_model_config" model="ir.actions.act_window">
        <field name="name">AI Models</field>
        <field name="res_model">ai.financial.model.config</field>
        <field name="view_mode">tree,form</field>
        <field name="search_view_id" ref="view_ai_financial_model_config_search"/>
        <field name="context">{'search_default_active_models': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Add your first AI Model
            </p>
            <p>
                Every model offered in the AI Model dropdowns — in Settings
                and on each report — comes from this list. Add a new model
                the moment a vendor ships one, or archive one the moment
                it's retired, with no code changes and no module update.
            </p>
        </field>
    </record>

    <!-- ================================================================ -->
    <!-- Settings shortcut action (Configuration ▸ Settings)              -->
    <!-- ================================================================ -->
    <record id="action_ai_financial_advisor_settings" model="ir.actions.act_window">
        <field name="name">Settings</field>
        <field name="res_model">res.config.settings</field>
        <field name="view_mode">form</field>
        <field name="target">inline</field>
        <field name="context">{'module': 'ai_financial_advisor'}</field>
    </record>

    <!-- ================================================================ -->
    <!-- Menus                                                            -->
    <!-- The existing top-level "AI Financial Reports" menu becomes a     -->
    <!-- "Reports" sub-item under a new "AI Financial Advisor" category,  -->
    <!-- which also gains "AI Models" (the catalog) and "Configuration".  -->
    <!-- ================================================================ -->
    <menuitem id="menu_ai_financial_advisor_root"
              name="AI Financial Advisor"
              parent="account.menu_finance"
              sequence="50"/>

    <menuitem id="menu_ai_financial_model_config"
              name="AI Models"
              action="action_ai_financial_model_config"
              parent="menu_ai_financial_advisor_root"
              sequence="20"/>

    <menuitem id="menu_ai_financial_advisor_settings"
              name="Configuration"
              action="action_ai_financial_advisor_settings"
              parent="menu_ai_financial_advisor_root"
              sequence="30"/>

</odoo>
