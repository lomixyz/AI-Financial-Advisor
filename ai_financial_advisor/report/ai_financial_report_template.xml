<?xml version="1.0" encoding="utf-8"?>
<odoo>

<template id="report_ai_financial_position_document">
    <t t-call="web.html_container">
        <t t-foreach="docs" t-as="o">
            <t t-call="web.external_layout">
                <div class="page">

                    <!-- ── Header ─────────────────────────────── -->
                    <div style="text-align:center; margin-bottom:20px; border-bottom:3px solid #2c3e50; padding-bottom:15px;">
                        <h1 style="color:#2c3e50; margin:0; font-size:24px;">
                            AI Financial Position Report
                        </h1>
                        <h3 style="color:#7f8c8d; margin:5px 0;">
                            <t t-esc="o.company_id.name"/>
                        </h3>
                        <p style="color:#95a5a6; margin:0;">
                            Period: <strong><t t-esc="o.date_from"/> to <t t-esc="o.date_to"/></strong>
                        </p>
                    </div>

                    <!-- ── AI Health Score ────────────────────── -->
                    <t t-if="o.state == 'ai_analyzed'">
                        <div style="background:#2c3e50; color:white; padding:12px 20px; border-radius:8px; margin-bottom:20px; display:flex; justify-content:space-between; align-items:center;">
                            <span style="font-size:16px; font-weight:bold;">
                                🏦 Financial Health Score
                            </span>
                            <span style="font-size:24px; font-weight:bold; color:#f1c40f;">
                                <t t-esc="o.ai_overall_score"/> / 100 —
                                <t t-esc="o.ai_score_label"/>
                            </span>
                        </div>
                    </t>

                    <!-- ── Balance Sheet ──────────────────────── -->
                    <h2 style="color:#2c3e50; border-bottom:1px solid #bdc3c7; padding-bottom:5px;">
                        Balance Sheet
                    </h2>

                    <table style="width:100%; border-collapse:collapse; margin-bottom:20px; font-size:12px;">
                        <thead>
                            <tr style="background:#2c3e50; color:white;">
                                <th style="padding:8px; text-align:left; width:40%;">Account</th>
                                <th style="padding:8px; text-align:right; width:30%;">Amount (<t t-esc="o.currency_id.symbol"/>)</th>
                                <th style="padding:8px; text-align:right; width:30%;">Notes</th>
                            </tr>
                        </thead>
                        <tbody>
                            <!-- Assets -->
                            <tr style="background:#ecf0f1; font-weight:bold;">
                                <td colspan="3" style="padding:6px 8px; color:#2c3e50;">ASSETS</td>
                            </tr>
                            <tr>
                                <td style="padding:5px 8px; padding-left:20px;">Cash &amp; Equivalents</td>
                                <td style="padding:5px 8px; text-align:right;">
                                    <t t-esc="'{:,.2f}'.format(o.cash_and_equivalents)"/>
                                </td>
                                <td></td>
                            </tr>
                            <tr style="background:#f9f9f9;">
                                <td style="padding:5px 8px; padding-left:20px;">Accounts Receivable</td>
                                <td style="padding:5px 8px; text-align:right;">
                                    <t t-esc="'{:,.2f}'.format(o.accounts_receivable)"/>
                                </td>
                                <td></td>
                            </tr>
                            <tr>
                                <td style="padding:5px 8px; padding-left:20px;">Inventory</td>
                                <td style="padding:5px 8px; text-align:right;">
                                    <t t-esc="'{:,.2f}'.format(o.inventory)"/>
                                </td>
                                <td></td>
                            </tr>
                            <tr style="background:#f9f9f9;">
                                <td style="padding:5px 8px; padding-left:20px;">Fixed Assets</td>
                                <td style="padding:5px 8px; text-align:right;">
                                    <t t-esc="'{:,.2f}'.format(o.fixed_assets)"/>
                                </td>
                                <td></td>
                            </tr>
                            <tr style="font-weight:bold; background:#d5e8d4; color:#27ae60;">
                                <td style="padding:6px 8px;">TOTAL ASSETS</td>
                                <td style="padding:6px 8px; text-align:right;">
                                    <t t-esc="'{:,.2f}'.format(o.total_assets)"/>
                                </td>
                                <td></td>
                            </tr>

                            <!-- Liabilities -->
                            <tr style="background:#ecf0f1; font-weight:bold;">
                                <td colspan="3" style="padding:6px 8px; color:#2c3e50;">LIABILITIES</td>
                            </tr>
                            <tr>
                                <td style="padding:5px 8px; padding-left:20px;">Accounts Payable</td>
                                <td style="padding:5px 8px; text-align:right;">
                                    <t t-esc="'{:,.2f}'.format(o.accounts_payable)"/>
                                </td>
                                <td></td>
                            </tr>
                            <tr style="background:#f9f9f9;">
                                <td style="padding:5px 8px; padding-left:20px;">Current Liabilities</td>
                                <td style="padding:5px 8px; text-align:right;">
                                    <t t-esc="'{:,.2f}'.format(o.current_liabilities)"/>
                                </td>
                                <td></td>
                            </tr>
                            <tr>
                                <td style="padding:5px 8px; padding-left:20px;">Long-term Debt</td>
                                <td style="padding:5px 8px; text-align:right;">
                                    <t t-esc="'{:,.2f}'.format(o.long_term_debt)"/>
                                </td>
                                <td></td>
                            </tr>
                            <tr style="font-weight:bold; background:#f8d7da; color:#c0392b;">
                                <td style="padding:6px 8px;">TOTAL LIABILITIES</td>
                                <td style="padding:6px 8px; text-align:right;">
                                    <t t-esc="'{:,.2f}'.format(o.total_liabilities)"/>
                                </td>
                                <td></td>
                            </tr>

                            <!-- Equity -->
                            <tr style="font-weight:bold; background:#d6eaf8; color:#2980b9;">
                                <td style="padding:6px 8px;">TOTAL EQUITY</td>
                                <td style="padding:6px 8px; text-align:right;">
                                    <t t-esc="'{:,.2f}'.format(o.total_equity)"/>
                                </td>
                                <td></td>
                            </tr>
                        </tbody>
                    </table>

                    <!-- ── Income Statement ───────────────────── -->
                    <h2 style="color:#2c3e50; border-bottom:1px solid #bdc3c7; padding-bottom:5px;">
                        Income Statement
                    </h2>
                    <table style="width:100%; border-collapse:collapse; margin-bottom:20px; font-size:12px;">
                        <tbody>
                            <tr>
                                <td style="padding:5px 8px; width:50%;">Total Revenue</td>
                                <td style="padding:5px 8px; text-align:right; color:#27ae60; font-weight:bold;">
                                    <t t-esc="'{:,.2f}'.format(o.total_revenue)"/>
                                </td>
                            </tr>
                            <tr style="background:#f9f9f9;">
                                <td style="padding:5px 8px;">Cost of Goods Sold</td>
                                <td style="padding:5px 8px; text-align:right;">
                                    (<t t-esc="'{:,.2f}'.format(o.cost_of_goods_sold)"/>)
                                </td>
                            </tr>
                            <tr style="font-weight:bold; background:#eafaf1;">
                                <td style="padding:6px 8px;">Gross Profit</td>
                                <td style="padding:6px 8px; text-align:right;">
                                    <t t-esc="'{:,.2f}'.format(o.gross_profit)"/>
                                </td>
                            </tr>
                            <tr style="background:#f9f9f9;">
                                <td style="padding:5px 8px;">Operating Expenses</td>
                                <td style="padding:5px 8px; text-align:right;">
                                    (<t t-esc="'{:,.2f}'.format(o.operating_expenses)"/>)
                                </td>
                            </tr>
                            <tr t-attf-style="font-weight:bold; background:#{o.net_income >= 0 and 'd5e8d4' or 'f8d7da'};">
                                <td style="padding:6px 8px;">NET INCOME / (LOSS)</td>
                                <td t-attf-style="padding:6px 8px; text-align:right; color:#{o.net_income >= 0 and '#27ae60' or '#c0392b'}; font-size:14px;">
                                    <t t-esc="'{:,.2f}'.format(o.net_income)"/>
                                </td>
                            </tr>
                        </tbody>
                    </table>

                    <!-- ── KPIs ───────────────────────────────── -->
                    <h2 style="color:#2c3e50; border-bottom:1px solid #bdc3c7; padding-bottom:5px;">
                        Key Performance Indicators
                    </h2>
                    <table style="width:100%; border-collapse:collapse; margin-bottom:20px; font-size:12px;">
                        <tr style="background:#ecf0f1;">
                            <td style="padding:8px; font-weight:bold;">Current Ratio</td>
                            <td style="padding:8px; text-align:right;"><t t-esc="'{:.2f}'.format(o.current_ratio)"/></td>
                            <td style="padding:8px; color:#7f8c8d;">Ideal: &gt; 1.5</td>
                        </tr>
                        <tr>
                            <td style="padding:8px; font-weight:bold;">Debt-to-Equity</td>
                            <td style="padding:8px; text-align:right;"><t t-esc="'{:.2f}'.format(o.debt_to_equity)"/></td>
                            <td style="padding:8px; color:#7f8c8d;">Ideal: &lt; 2.0</td>
                        </tr>
                        <tr style="background:#ecf0f1;">
                            <td style="padding:8px; font-weight:bold;">Gross Margin</td>
                            <td style="padding:8px; text-align:right;"><t t-esc="'{:.1f}%'.format(o.gross_margin_pct)"/></td>
                            <td></td>
                        </tr>
                        <tr>
                            <td style="padding:8px; font-weight:bold;">Net Margin</td>
                            <td style="padding:8px; text-align:right;"><t t-esc="'{:.1f}%'.format(o.net_margin_pct)"/></td>
                            <td></td>
                        </tr>
                        <tr style="background:#ecf0f1;">
                            <td style="padding:8px; font-weight:bold;">Return on Assets</td>
                            <td style="padding:8px; text-align:right;"><t t-esc="'{:.1f}%'.format(o.return_on_assets)"/></td>
                            <td></td>
                        </tr>
                    </table>

                    <!-- ── AI Recommendations (if available) ─── -->
                    <t t-if="o.state == 'ai_analyzed'">
                        <div style="page-break-before:always;"/>

                        <h2 style="color:#2c3e50; border-bottom:3px solid #3498db; padding-bottom:8px;">
                            🤖 AI Financial Recommendations
                        </h2>

                        <!-- Executive Summary -->
                        <div style="background:#eaf4fb; border-left:4px solid #3498db; padding:12px 15px; margin-bottom:20px; border-radius:4px;">
                            <h3 style="color:#2980b9; margin-top:0;">Executive Summary</h3>
                            <p style="margin:0; font-size:12px; line-height:1.6;">
                                <t t-raw="o.ai_summary"/>
                            </p>
                        </div>

                        <!-- 2-column recommendations -->
                        <table style="width:100%; border-collapse:collapse; margin-bottom:20px;">
                            <tr>
                                <td style="width:50%; vertical-align:top; padding-right:10px;">
                                    <div style="background:#eafaf1; border-left:4px solid #27ae60; padding:12px; border-radius:4px;">
                                        <h3 style="color:#27ae60; margin-top:0; font-size:13px;">
                                            📈 Income Increase Recommendations
                                        </h3>
                                        <p style="font-size:11px; line-height:1.7; margin:0; white-space:pre-wrap;">
                                            <t t-raw="o.ai_income_recommendations"/>
                                        </p>
                                    </div>
                                </td>
                                <td style="width:50%; vertical-align:top; padding-left:10px;">
                                    <div style="background:#fef9e7; border-left:4px solid #f39c12; padding:12px; border-radius:4px;">
                                        <h3 style="color:#e67e22; margin-top:0; font-size:13px;">
                                            ✂️ Expense Reduction Recommendations
                                        </h3>
                                        <p style="font-size:11px; line-height:1.7; margin:0; white-space:pre-wrap;">
                                            <t t-raw="o.ai_expense_recommendations"/>
                                        </p>
                                    </div>
                                </td>
                            </tr>
                        </table>

                        <table style="width:100%; border-collapse:collapse; margin-bottom:20px;">
                            <tr>
                                <td style="width:50%; vertical-align:top; padding-right:10px;">
                                    <div style="background:#f5eef8; border-left:4px solid #8e44ad; padding:12px; border-radius:4px;">
                                        <h3 style="color:#8e44ad; margin-top:0; font-size:13px;">
                                            🛒 Purchasing Optimization
                                        </h3>
                                        <p style="font-size:11px; line-height:1.7; margin:0; white-space:pre-wrap;">
                                            <t t-raw="o.ai_purchasing_recommendations"/>
                                        </p>
                                    </div>
                                </td>
                                <td style="width:50%; vertical-align:top; padding-left:10px;">
                                    <div style="background:#fdedec; border-left:4px solid #e74c3c; padding:12px; border-radius:4px;">
                                        <h3 style="color:#c0392b; margin-top:0; font-size:13px;">
                                            ⚠️ Risk Alerts
                                        </h3>
                                        <p style="font-size:11px; line-height:1.7; margin:0; white-space:pre-wrap;">
                                            <t t-raw="o.ai_risk_alerts"/>
                                        </p>
                                    </div>
                                </td>
                            </tr>
                        </table>

                        <!-- Footer note -->
                        <div style="background:#f2f3f4; padding:10px; border-radius:4px; font-size:10px; color:#7f8c8d; text-align:center;">
                            AI recommendations generated on
                            <t t-esc="o.ai_generated_at"/> |
                            This report is for advisory purposes. Consult a qualified accountant before making financial decisions.
                        </div>
                    </t>

                </div>
            </t>
        </t>
    </t>
</template>
</odoo>
